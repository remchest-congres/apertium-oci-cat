      </program>
      <program name="apertium-transfer -b">
        <file name="cat-oci_aran.t1x"/>
        <file name="cat-oci_aran.t1x.bin"/>
      </program>
      <program name="apertium-interchunk">
        <file name="cat-oci_aran.t2x"/>
